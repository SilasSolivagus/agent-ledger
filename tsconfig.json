{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2023"], "module": "NodeNext", "moduleResolution": "NodeNext",
    "outDir": "lib", "rootDir": "src", "declaration": true, "strict": true,
    "noUncheckedIndexedAccess": true, "skipLibCheck": true, "types": ["node"]
  },
  "include": ["src/**/*.ts"]
}
