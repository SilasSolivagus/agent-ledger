{
  "name": "runledger",
  "version": "0.3.1",
  "description": "See what your coding agent actually did — session trajectory and cost dashboard for Claude Code, Codex, and any agent that talks HTTP",
  "keywords": [
    "claude-code",
    "codex",
    "agent",
    "observability",
    "tokens",
    "trajectory",
    "runledger",
    "cost"
  ],
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "bin": {
    "agent-ledger": "bin/agent-ledger.js"
  },
  "files": [
    "bin/*.js",
    "lib/**/*.d.ts",
    "lib/**/*.js"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SilasSolivagus/agent-ledger.git"
  },
  "homepage": "https://github.com/SilasSolivagus/agent-ledger#readme",
  "bugs": {
    "url": "https://github.com/SilasSolivagus/agent-ledger/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test tests/*.test.js",
    "prices:check": "node scripts/prices-check.mjs",
    "check": "npm run build && npm run test",
    "prepublishOnly": "npm run check"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^5.7.0"
  }
}
